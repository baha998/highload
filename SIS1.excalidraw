    {
      "id": "6pSZc-6Al5GlpYdUwzB5G",
      "type": "text",
      "x": -2314.8431531162746,
      "y": 6602.605852452569,
      "width": 922.7009482497971,
      "height": 665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH0",
      "roundness": null,
      "seed": 1750970624,
      "version": 648,
      "versionNonce": 162897664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792222424372,
      "created": 1792222104904,
      "link": null,
      "locked": false,
      "text": "PostgreSQL: 1 Primary + 2 replicas\n- 1 sync replica\n- 1 async replica\n\nproduct(id PK, sku, title, description, price, category_id,\n        brand_id, attributes jsonb, images, in_stock, version,\nupdated_at)\ncategory(id PK, parent_id, name)\nbrand(id PK, name)\noutbox(id PK, product_id, version) -- same transaction as product\n\nIndexes:\n- PK(id): card lookup in a few ms\n- (category_id, price, id): listing sorted by price from index,\n  id is tie-breaker for cursor\n\nElasticsearch: title (text), brand, category path, price,\nin_stock, attributes -> text search, filters, facets\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PostgreSQL: 1 Primary + 2 replicas\n- 1 sync replica\n- 1 async replica\n\nproduct(id PK, sku, title, description, price, category_id,\n        brand_id, attributes jsonb, images, in_stock, version, updated_at)\ncategory(id PK, parent_id, name)\nbrand(id PK, name)\noutbox(id PK, product_id, version) -- same transaction as product\n\nIndexes:\n- PK(id): card lookup in a few ms\n- (category_id, price, id): listing sorted by price from index,\n  id is tie-breaker for cursor\n\nElasticsearch: title (text), brand, category path, price,\nin_stock, attributes -> text search, filters, facets\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
