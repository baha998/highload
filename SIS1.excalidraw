    },
    {
      "id": "xfT1Ei4xrnZMxU_gWK6oR",
      "type": "text",
      "x": -2308.7749590998123,
      "y": 5294.708051162313,
      "width": 800,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGB",
      "roundness": null,
      "seed": 1706870671,
      "version": 517,
      "versionNonce": 494681856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792221979877,
      "created": 1792183403207,
      "link": null,
      "locked": false,
      "text": "Assumption: of 10,000 read RPS, 60% are cards (6,000),\n25% category listings (2,500), 15% search (1,500)\nWrites 20 RPS * 86400 = 1.7M per day. REad-to-write is\n500:1 so our system is read-heavy\nDB size 1M product * 4KB = 4GB, about 6GB with\nindexes. One node holds everything, o no sharding \nImages 1M * 5 files * 300KB = 1.5TB \nCache 1M * 5KB = 5 GB so whole catalog can fit in redis\nCache answers ~90% of reads\nBandwidth: 10,000 RPS * 5 KB = 50 MB/s\nInstances: 1 service instance ~2,000 RPS -> 6 instances\n+ 2 spare\n\nLatency budget (p99 < 80 ms):\nNetwork + CDN ~10 ms, Gateway ~5 ms, Service ~5 ms\nCache hit ~5 ms -> total ~25 ms\nSearch (ES) up to 40 ms -> total ~60 ms",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumption: of 10,000 read RPS, 60% are cards (6,000), 25% category listings (2,500), 15% search (1,500)\nWrites 20 RPS * 86400 = 1.7M per day. REad-to-write is 500:1 so our system is read-heavy\nDB size 1M product * 4KB = 4GB, about 6GB with indexes. One node holds everything, o no sharding \nImages 1M * 5 files * 300KB = 1.5TB \nCache 1M * 5KB = 5 GB so whole catalog can fit in redis\nCache answers ~90% of reads\nBandwidth: 10,000 RPS * 5 KB = 50 MB/s\nInstances: 1 service instance ~2,000 RPS -> 6 instances + 2 spare\n\nLatency budget (p99 < 80 ms):\nNetwork + CDN ~10 ms, Gateway ~5 ms, Service ~5 ms\nCache hit ~5 ms -> total ~25 ms\nSearch (ES) up to 40 ms -> total ~60 ms",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
