      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "96qzot6BuF-s-d4ZT4r8F",
      "type": "text",
      "x": -2337.2962033506406,
      "y": 8429.52176665236,
      "width": 800,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH9",
      "roundness": null,
      "seed": 2002489600,
      "version": 455,
      "versionNonce": 727904512,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792223243399,
      "created": 1792223191953,
      "link": null,
      "locked": false,
      "text": "1. Eventual consistency: price in listing can be 1-2 min old.\nCheckout reads DB.\n2. Elasticsearch + indexer: needed for filters/facets, but\nmore to run.\n3. Whole catalog in Redis (~10 GB with listings): memory\ncost for stable hit ratio.\n4. No sharding: simpler now, revisit above ~1 TB.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Eventual consistency: price in listing can be 1-2 min old.\nCheckout reads DB.\n2. Elasticsearch + indexer: needed for filters/facets, but more to run.\n3. Whole catalog in Redis (~10 GB with listings): memory cost for stable hit ratio.\n4. No sharding: simpler now, revisit above ~1 TB.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
