    {
      "id": "wAc2X8J1JP4BED0H81ZAr",
      "type": "text",
      "x": -2325.9112745201896,
      "y": 7860.442680514228,
      "width": 184,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
